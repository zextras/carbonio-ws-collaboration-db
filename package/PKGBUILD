pkgname="carbonio-ws-collaboration-db"
pkgver="0.6.7"
pkgrel="1"
pkgdesc="Carbonio Workstream Collaboration DB sidecar"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('any')
license=("AGPL-3.0-only")
depends=(
  "carbonio-core"
  "jq"
  "pending-setups"
  "service-discover"
  "service-discover-base"
)
backup=(
  "etc/zextras/service-discover/${pkgname}.hcl"
)
source=(
  "111-${pkgname}-setup.sh"
  "${pkgname}"
  "${pkgname}.hcl"
  "${pkgname}-bootstrap"
  "${pkgname}-sidecar.service"
  "${pkgname}-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
sha256sums=(
  '0ce7138ea81d19fabe18b24150fa3240ce0456eda4105d3b1a76598ecc0f32dd'
  'fa1768100edf7876e7b3ba04c59d9f4dee2514dbcd5961b62bde1dd93fb39189'
  '50da5e81599445ef22296e51cade1328ba6f4d39f9ef937c9ba791568392b73c'
  '6d685ead16a0297514de5126c9bf084fe39bbfa9ce6bf5770a00c71e865c6cab'
  '773fe7fccaf1be343573623975f5124d67a2ad3ae8333bb88cba784f3fc4fbdd'
