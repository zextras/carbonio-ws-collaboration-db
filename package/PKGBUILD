url="https://zextras.com"
section="mail"
priority="optional"
arch=('any')
license=("AGPL-3.0-only")
depends=(
  "carbonio-core"
  "jq"
  "pending-setups"
  "service-discover"
  "service-discover-base"
  "service-discover-template"
)
source=(
  "111-${pkgname}-setup.sh"
  "${pkgname}"
  "${pkgname}-template.hcl"
  "${pkgname}-bootstrap"
  "${pkgname}-sidecar.service"
  "${pkgname}-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
