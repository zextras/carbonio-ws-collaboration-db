pkgname="carbonio-ws-collaboration-db"
pkgver="0.3.1"
pkgrel="SNAPSHOT"
pkgdesc="Carbonio Workstream Collaboration DB sidecar"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('any')
license=("AGPL-3.0-only")
depends=(
  "carbonio-core"
  "jq"
  "pending-setups"
  "service-discover"
)
backup=(
  "etc/zextras/service-discover/${pkgname}.hcl"
)
source=(
  "111-${pkgname}-setup.sh"
  "${pkgname}"
  "${pkgname}.hcl"
  "${pkgname}-bootstrap"
  "${pkgname}-sidecar.service"
  "${pkgname}-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
sha256sums=(
  '2c175f681ebb7cbac3f8f034ffe08d99d59b8a68824ebcfce1877c22614efd66'
  '72692652bbb341b6f35a81171063b2bbf9780b60ae91c266575aaa4dde255ac7'
  '59a74fcfbbfaf4628271bfa4d4e76c46d508f7b21d3a79d46ad51f96b8083695'
  'cbcdea3b53ed934a0e4280be9ab3434118a8c096c81a9cc68f007ff59f68520f'
  '6ed3ab14e72e4de771b13eee2971c57c15df97882b3a1926b333b3c357510869'
  'd1fc1d459676c52bf147204fcc9145143a9d79937dad407d22fe666b6d3ca1d3'
  '87b5d43d577bd805a74aa5f38ded4cc5a755ba35ab8266c8f3b60f3a091a07c3'
  '9bedfb38742c72034f015aee3f1e7bdb734cd5d6e0003b109a8d6fead4962a8c'
  'd0f4019f14ff13fe5d394e9945c6679c1098f532c8bffd41b129e1a804947ac1'
)

_package_common() {
  install -Dm644 "${srcdir}/111-${pkgname}-setup.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/111-${pkgname}-setup.sh"
  install -Dm755 "${srcdir}/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/${pkgname}.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"
  install -Dm755 "${srcdir}/${pkgname}-bootstrap" \
    "${pkgdir}/usr/bin/${pkgname}-bootstrap"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/ws-collaboration-db/service-discover/intentions.json"
  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/ws-collaboration-db/service-discover/policies.json"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/ws-collaboration-db/service-discover/service-protocol.json"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/${pkgname}-sidecar.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/${pkgname}-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

package() { _package_systemd; }
package__rocky_8() { _package_legacy; }
package__ubuntu_jammy() { _package_legacy; }

postinst() {
  getent group 'carbonio-ws-collaboration-db' >/dev/null \
    || groupadd -r 'carbonio-ws-collaboration-db'
  getent passwd 'carbonio-ws-collaboration-db' >/dev/null \
    || useradd -r -M -g 'carbonio-ws-collaboration-db' -s /sbin/nologin 'carbonio-ws-collaboration-db'

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-ws-collaboration-db-sidecar.service >/dev/null 2>&1 || :
  fi

  echo "============================================================"
  echo "Carbonio Workstream Collaboration DB installed successfully!"
  echo "You must run pending-setups to configure it correctly.      "
  echo "============================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-ws-collaboration-db-sidecar.service >/dev/null 2>&1 || :
    systemctl stop carbonio-ws-collaboration-db-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/carbonio/ws-collaboration/service-discover/token
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
